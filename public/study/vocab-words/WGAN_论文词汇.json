[{"sec": "1. Introduction · 引言", "short": "Intro", "icon": "1", "words": [{"w": "density", "ipa": "ˈdensəti", "pos": "n.", "lv": "4", "m": "密度（概率密度）", "ex": "The classical answer to this is to learn a probability density"}, {"w": "parametric", "ipa": "ˌpærəˈmetrɪk", "pos": "adj.", "lv": "p", "m": "参数化的", "ex": "deﬁning a parametric family of densities"}, {"w": "likelihood", "ipa": "ˈlaɪklihʊd", "pos": "n.", "lv": "6", "m": "似然", "ex": "ﬁnding the one that maximized the likelihood on our data"}, {"w": "asymptotically", "ipa": "ˌæsɪmpˈtɑːtɪkli", "pos": "adv.", "lv": "p", "m": "渐近地", "ex": "asymptotically, this amounts to minimizing the KL divergence"}, {"w": "divergence", "ipa": "daɪˈvɜːrdʒəns", "pos": "n.", "lv": "p", "m": "散度", "ex": "minimizing the Kullback-Leibler divergence"}, {"w": "manifold", "ipa": "ˈmænɪfoʊld", "pos": "n.", "lv": "6", "m": "流形", "ex": "distributions supported by low dimensional manifolds"}, {"w": "negligible", "ipa": "ˈneɡlɪdʒəbl", "pos": "adj.", "lv": "6", "m": "可忽略的", "ex": "a non-negligible intersection"}, {"w": "inﬁnite", "ipa": "ˈɪnfɪnət", "pos": "adj.", "lv": "p", "m": "无穷的", "ex": "the KL distance is not deﬁned (or simply inﬁnite)"}, {"w": "remedy", "ipa": "ˈremədi", "pos": "n.", "lv": "4", "m": "补救办法", "ex": "The typical remedy is to add a noise term"}, {"w": "virtually", "ipa": "ˈvɜːrtʃuəli", "pos": "adv.", "lv": "4", "m": "几乎", "ex": "virtually all generative models"}, {"w": "bandwidth", "ipa": "ˈbændwɪdθ", "pos": "n.", "lv": "p", "m": "带宽", "ex": "a Gaussian noise with relatively high bandwidth"}, {"w": "degrade", "ipa": "dɪˈɡreɪd", "pos": "v.", "lv": "6", "m": "使变差", "ex": "this noise degrades the quality of the samples"}, {"w": "blurry", "ipa": "ˈblɜːri", "pos": "adj.", "lv": "p", "m": "模糊的", "ex": "makes them blurry"}, {"w": "deviation", "ipa": "ˌdiːviˈeɪʃn", "pos": "n.", "lv": "6", "m": "偏差（标准差）", "ex": "the optimal standard deviation of the noise"}, {"w": "optimal", "ipa": "ˈɑːptɪml", "pos": "adj.", "lv": "6", "m": "最优的", "ex": "This shows that D∗ is optimal"}, {"w": "attain", "ipa": "əˈteɪn", "pos": "v.", "lv": "4", "m": "达到", "ex": "f∗ that attains the value of the inﬁmum"}, {"w": "inﬁmum", "ipa": "ˈɪnfɪməm", "pos": "n.", "lv": "p", "m": "下确界", "ex": "the value of the inﬁmum"}]}]